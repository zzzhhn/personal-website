{
  "name": "personal-website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node tools/world/check-club-audio.mjs && node --import ./tools/world/alpha-mine-tests/register.mjs --test --test-name-pattern=declared.collision src/components/world/alpha-island/alpha-mainland-pier.test.mjs && node --import ./tools/world/alpha-mine-tests/register.mjs --test src/components/world/alpha-island/alpha-trail-placement.test.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:coaster-scene": "node --import ./tools/world/alpha-mine-tests/register.mjs --test --test-concurrency=1 src/components/world/attractions/coaster-craft-promotion.test.mjs src/components/world/attractions/coaster-chest-runtime.test.mjs src/components/world/attractions/coaster-gate-craft-lifecycle.test.mjs",
    "check:grounding": "node --import ./tools/world/alpha-mine-tests/register.mjs --test --test-concurrency=1 tools/world/terrain-artifact.test.mjs tools/world/alpha-terrain-artifact.test.mjs tools/world/cave-surface-artifact.test.mjs tools/world/waterwheel-surface-artifact.test.mjs tools/world/mainland-placement.test.mjs src/components/world/alpha-island/alpha-mainland-pier.test.mjs src/components/world/alpha-island/alpha-trail-placement.test.mjs",
    "capture:evalforge": "bash scripts/capture-evalforge-previews.sh"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/react": "^5.0.2",
    "@astrojs/sitemap": "^3.7.2",
    "@dimforge/rapier3d-compat": "0.19.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/rapier": "2.2.0",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.3",
    "ecctrl": "2.0.2",
    "framer-motion": "^12.38.0",
    "mermaid": "^11.14.0",
    "ogl": "^1.0.11",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "three": "0.186.1",
    "three-mesh-bvh": "0.8.3",
    "zustand": "5.0.15"
  },
  "overrides": {
    "vite": "^7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "typescript": "^5.9.3",
    "vercel": "^50.42.0"
  }
}
