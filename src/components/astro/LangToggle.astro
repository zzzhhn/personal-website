---
---

<button
  aria-label="Toggle language"
  class="lang-toggle px-2.5 py-1 rounded-lg text-xs font-semibold transition-all cursor-pointer"
>
  <span data-lang="en">中</span>
  <span data-lang="zh">EN</span>
</button>

<style is:global>
  .lang-toggle {
    background: transparent;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border-glass);
  }
  .lang-toggle:hover {
    background: var(--color-glow-ambient);
    color: var(--color-text-primary);
    border-color: var(--color-border-highlight);
  }
</style>

<script is:inline>
  (function () {
    if (window.__langToggleInit) return;
    window.__langToggleInit = true;
    document.addEventListener("click", function (e) {
      var btn = e.target.closest(".lang-toggle");
      if (!btn) return;
      if (window.__langAnchorCleanup) window.__langAnchorCleanup();

      var readingY = Math.min(window.innerHeight * 0.38, 380);
      var visibleWorkflows = Array.from(document.querySelectorAll(".tl-row .wf-container"))
        .filter(function (workflow) {
          var rect = workflow.getBoundingClientRect();
          var visibleHeight = Math.min(rect.bottom, window.innerHeight) - Math.max(rect.top, 0);
          return visibleHeight >= Math.min(80, rect.height * 0.25);
        })
        .sort(function (a, b) {
          var aRect = a.getBoundingClientRect();
          var bRect = b.getBoundingClientRect();
          var aDistance = Math.abs((aRect.top + aRect.bottom) / 2 - readingY);
          var bDistance = Math.abs((bRect.top + bRect.bottom) / 2 - readingY);
          return aDistance - bDistance;
        });

      // The timeline axis occupies the viewport centre, so probing only at 50%
      // always collapses to .tl-row. Prefer the visible expanded workflow itself;
      // otherwise probe both reading columns before falling back to the section.
      var anchor = visibleWorkflows[0] || null;
      if (!anchor) {
        var probeXs = [window.innerWidth * 0.25, window.innerWidth * 0.75, window.innerWidth * 0.5];
        for (var i = 0; i < probeXs.length && !anchor; i++) {
          var anchorTarget = document.elementFromPoint(probeXs[i], readingY);
          anchor = anchorTarget
            ? anchorTarget.closest(".wf-container, .tl-card, .project-card-slot, section[id], main")
            : null;
        }
      }
      var anchorTop = anchor ? anchor.getBoundingClientRect().top : 0;
      var current = document.documentElement.getAttribute("data-site-lang") || "en";
      var next = current === "en" ? "zh" : "en";
      document.documentElement.setAttribute("data-site-lang", next);
      document.documentElement.setAttribute("lang", next === "zh" ? "zh-CN" : "en");
      localStorage.setItem("lang", next);

      function restoreReadingPosition() {
        if (!anchor || !anchor.isConnected) return;
        var delta = anchor.getBoundingClientRect().top - anchorTop;
        if (Math.abs(delta) > 0.5) window.scrollBy(0, delta);
      }

      var resizeObserver = null;
      var cleanupTimer = null;
      if (anchor && window.ResizeObserver) {
        resizeObserver = new ResizeObserver(restoreReadingPosition);
        resizeObserver.observe(anchor);
        var anchorRow = anchor.closest(".tl-row");
        if (anchorRow && anchorRow !== anchor) resizeObserver.observe(anchorRow);
      }

      window.__langAnchorCleanup = function () {
        if (resizeObserver) resizeObserver.disconnect();
        if (cleanupTimer) window.clearTimeout(cleanupTimer);
        window.__langAnchorCleanup = null;
      };

      function settleFrames(remaining) {
        if (remaining <= 0) return;
        requestAnimationFrame(function () {
          restoreReadingPosition();
          settleFrames(remaining - 1);
        });
      }

      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          restoreReadingPosition();
          settleFrames(10);
          // Read fonts.ready only after the new language has been painted, so a
          // newly-used CJK fallback font is included in the pending font set.
          if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(function () { settleFrames(4); });
          }
        });
      });
      cleanupTimer = window.setTimeout(window.__langAnchorCleanup, 1200);
    });
  })();
</script>
