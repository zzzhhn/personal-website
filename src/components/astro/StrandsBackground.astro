---
import Strands from "../react/Strands";
---

<div class="site-strands" aria-hidden="true">
  <Strands
    client:idle
    colors={["#74a8ff", "#71e0b2", "#efb06a"]}
    lightColors={["#1f57c8", "#197f62", "#a96714"]}
    speed={0.5}
    amplitude={1}
    thickness={1}
    glow={1.15}
  />
</div>

<style>
  .site-strands {
    position: fixed;
    z-index: -1;
    inset: 64px 0 0;
    overflow: hidden;
    opacity: 0.3;
    pointer-events: none;
  }

  :global([data-theme="dark"]) .site-strands {
    opacity: 0.44;
  }

  @media (max-width: 768px), (pointer: coarse), (prefers-reduced-motion: reduce) {
    .site-strands {
      display: none;
    }
  }
</style>
