---
import { getCollection } from 'astro:content';
import WorldApp from '../components/world/WorldApp';
import { EXPERIENCES, UI } from '../lib/i18n';
import { BUILDINGS } from '../components/world/layout';
import type { WorldAbout, WorldContent } from '../components/world/types';
// The homepage's bilingual timeline is the sole source for the six buildings.
// Card fields (location, highlights, ...) are copied through unchanged so world cards never retype facts.
type SourceExperience = { organization: string; role: string; startDate: string; endDate?: string; location?: string; type?: string; highlights?: readonly string[]; techStack?: readonly string[] };
const chronological = (entries: readonly SourceExperience[]) => [...entries]
  .sort((a, b) => a.startDate.localeCompare(b.startDate))
  .map(({ organization, role, startDate, endDate, location, type, highlights, techStack }) => ({
    organization, role, startDate, endDate, location, type,
    highlights: highlights ? [...highlights] : undefined, techStack: techStack ? [...techStack] : undefined,
  }));
const experiences: WorldContent['experiences'] = {
  en: chronological(EXPERIENCES.en),
  zh: chronological(EXPERIENCES.zh),
};
if (experiences.en.length !== BUILDINGS.length || experiences.zh.length !== BUILDINGS.length ||
  experiences.en.some((entry, i) => !entry.organization || !entry.role || !entry.startDate ||
    entry.startDate !== experiences.zh[i].startDate) ||
  experiences.zh.some(entry => !entry.organization || !entry.role || !entry.startDate)) {
  throw new Error('The world requires six complete, date-aligned bilingual experience slots.');
}
const isoDay = (d?: Date) => (d ? d.toISOString().slice(0, 10) : undefined);
// Course pages come from the project's own bilingual MDX table (`| **CODE · Name** | problem | response |`),
// so the blackboard page count follows the content source instead of a hard-coded list.
const courseRows = (body: string | undefined, lang: 'en' | 'zh') => {
  const section = body?.split(`<section data-lang="${lang}">`)[1]?.split('</section>')[0] ?? '';
  return [...section.matchAll(/^\|\s*\*\*([A-Z]{2,4}\d{4})\s*·\s*([^*]+)\*\*\s*\|([^|]+)\|([^|]+)\|/gm)]
    .map(m => ({ code: m[1], name: m[2].trim(), problem: m[3].trim(), response: m[4].trim() }));
};
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order).map(({ data, body }) => ({
  slug: data.slug, title: data.title, titleZh: data.titleZh,
  tagline: data.tagline, taglineZh: data.taglineZh, maintenance: data.maintenance,
  description: data.description, descriptionZh: data.descriptionZh,
  highlights: data.highlights, highlightsZh: data.highlightsZh, techStack: data.techStack,
  maturity: data.maturity, date: isoDay(data.date), endDate: isoDay(data.endDate), links: data.links,
  ...(courseRows(body, 'en').length ? { courses: { en: courseRows(body, 'en'), zh: courseRows(body, 'zh') } } : {}),
}));
// About-camp cards read the same UI fields as the homepage About / Education sections.
const about: WorldAbout = {
  tagline: UI.hero.tagline, positioning: UI.hero.positioning, bio: [...UI.about.bio],
  techCategories: { en: UI.about.techCategories.en.map(c => ({ label: c.label, items: [...c.items] })), zh: UI.about.techCategories.zh.map(c => ({ label: c.label, items: [...c.items] })) },
  education: {
    school: UI.education.school, degree: UI.education.degree, period: UI.education.period, expectedGrad: UI.education.expectedGrad,
    awards: { en: UI.education.awards.en.map(a => ({ label: a.label })), zh: UI.education.awards.zh.map(a => ({ label: a.label })) },
    certificates: { en: [...UI.education.certificates.en], zh: [...UI.education.certificates.zh] },
    languages: { en: UI.education.languages.en.map(l => ({ ...l })), zh: UI.education.languages.zh.map(l => ({ ...l })) },
    courses: { en: [...UI.education.courses.en], zh: [...UI.education.courses.zh] },
  },
  // EN keeps singing / gym in paragraph 2, ZH lists 唱歌、健身、主持、烹饪、旅行 in paragraph 3 (UI.about.bio).
  interestsParagraph: { en: 1, zh: 2 },
  sections: { about: UI.sections.about, education: UI.sections.education, experience: UI.sections.experience, projects: UI.sections.projects, certificates: UI.sections.certificates, languages: UI.sections.languages },
};
---
<!doctype html>
<html lang="en" data-site-lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="description" content="Explore Bobby’s island. A playable camp art sample with the rest of the island in greybox." />
    <title>Bobby’s island · World playtest</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>@font-face{font-family:Geist;src:url('/fonts/GeistSans-Regular.woff2') format('woff2');font-display:swap}@font-face{font-family:Geist;font-weight:500;src:url('/fonts/GeistSans-Medium.woff2') format('woff2');font-display:swap}@font-face{font-family:Geist;font-weight:600;src:url('/fonts/GeistSans-SemiBold.woff2') format('woff2');font-display:swap}@font-face{font-family:'Instrument Serif';src:url('/fonts/InstrumentSerif-Regular.woff2') format('woff2');font-display:swap}@font-face{font-family:'Instrument Serif';font-style:italic;src:url('/fonts/InstrumentSerif-Italic.woff2') format('woff2');font-display:swap}html,body{margin:0;background:#1c353e}</style>
    <script is:inline>try{var lang=localStorage.getItem('lang')==='zh'?'zh':'en';document.documentElement.dataset.siteLang=lang;document.documentElement.lang=lang==='zh'?'zh-CN':'en'}catch{}</script>
  </head>
  <body>
    <WorldApp client:only="react" content={{ experiences, projects, about }} />
    <noscript><p style="color:#fff;padding:2rem">Enable JavaScript on desktop to enter the island. <a href="/" style="color:#4fd1c5">Back to portfolio</a></p></noscript>
  </body>
</html>
