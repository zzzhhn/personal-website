---
import { getCollection, render } from "astro:content";
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import {
  PROJECT_MAINTENANCE_LABELS,
  PROJECT_MATURITY_LABELS,
} from "../../lib/projectStatus";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const {
  title,
  titleZh,
  tagline,
  taglineZh,
  description,
  date,
  endDate,
  maturity,
  maintenance,
  techStack,
  links,
} = project.data;
const maturityLabel = PROJECT_MATURITY_LABELS[maturity];
const maintenanceLabel = PROJECT_MAINTENANCE_LABELS[maintenance];

function formatDate(d: Date, locale: "en-US" | "zh-CN"): string {
  return d.toLocaleDateString(locale, { year: "numeric", month: "long" });
}
---

<ProjectLayout title={title} description={description}>
  <!-- Project header -->
  <header class="mb-12">
    <div class="flex items-center gap-3 mb-4">
      <div class="project-status-group">
        <span class={`project-status-badge project-status-badge--${maturity}`}>
          <span data-lang="en">{maturityLabel.en}</span>
          <span data-lang="zh">{maturityLabel.zh}</span>
        </span>
        <span class={`project-status-badge project-status-badge--${maintenance}`}>
          <span class="project-status-dot" aria-hidden="true"></span>
          <span data-lang="en">{maintenanceLabel.en}</span>
          <span data-lang="zh">{maintenanceLabel.zh}</span>
        </span>
      </div>
      <span class="text-sm" style="color: var(--color-text-secondary);">
        <span data-lang="en">{formatDate(date, "en-US")}{endDate ? ` — ${formatDate(endDate, "en-US")}` : ""}</span>
        <span data-lang="zh">{formatDate(date, "zh-CN")}{endDate ? `至${formatDate(endDate, "zh-CN")}` : ""}</span>
      </span>
    </div>

    <h1
      class="text-3xl md:text-4xl font-semibold mb-4"
      style="color: var(--color-text-primary); letter-spacing: -0.02em;"
    >
      <span data-lang="en">{title}</span>
      <span data-lang="zh">{titleZh}</span>
    </h1>

    <p class="text-lg mb-6" style="color: var(--color-accent);">
      <span data-lang="en">{tagline}</span>
      <span data-lang="zh">{taglineZh}</span>
    </p>

    <!-- Tech stack -->
    <div class="flex flex-wrap gap-2 mb-6">
      {techStack.map((tech) => (
        <span
          class="text-xs px-2 py-1 rounded-md"
          style="background-color: var(--color-surface-secondary); color: var(--color-text-secondary);"
        >
          {tech}
        </span>
      ))}
    </div>

    <!-- Links -->
    <div class="flex items-center gap-4">
      {links.github && (
        <a
          href={links.github}
          target="_blank"
          rel="noopener noreferrer"
          class="project-action-link"
          style="color: var(--color-text-primary); text-decoration: none;"
        >
          GitHub
        </a>
      )}
      {links.live && (
        <a
          href={links.live}
          target="_blank"
          rel="noopener noreferrer"
          class="project-action-link project-action-link--primary"
          data-analytics-event="project_live_click"
          data-analytics-target={project.data.slug}
          style="color: var(--color-text-primary); text-decoration: none;"
        >
          <span data-lang="en">Live Demo</span>
          <span data-lang="zh">在线体验</span>
        </a>
      )}
    </div>
  </header>

  <!-- MDX content -->
  <div class="prose-custom">
    <Content />
  </div>
</ProjectLayout>

<style>
  /* Prose-like styling for MDX content without @tailwindcss/typography */
  .prose-custom :global(h2) {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .prose-custom :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--color-text-primary);
  }

  .prose-custom :global(p) {
    margin-bottom: 1.25rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
  }

  .prose-custom :global(ul),
  .prose-custom :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    color: var(--color-text-secondary);
  }

  .prose-custom :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .prose-custom :global(code) {
    font-size: 0.875rem;
    padding: 0.15rem 0.4rem;
    border-radius: 0.25rem;
    background-color: var(--color-surface-secondary);
    color: var(--color-accent);
  }

  .prose-custom :global(pre) {
    padding: 1.25rem;
    border-radius: 0.75rem;
    margin-bottom: 1.5rem;
    overflow-x: auto;
    background-color: var(--color-surface-secondary) !important;
  }

  .prose-custom :global(strong) {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .prose-custom :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
