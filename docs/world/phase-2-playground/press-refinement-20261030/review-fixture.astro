---
import World from './world.astro';
---
<World />
<script>
  import { WORLD_SHOTS } from '../components/world/layout';
  import { useWorldStore, selectWorldTime } from '../components/world/store';
  import { worldActorDebug } from '../components/world/WorldActors';
  import { factoryWorld } from '../components/world/factory/factory-layout';
  import { factoryControl, useFactoryStore } from '../components/world/factory/factory-store';
  import { FACTORY_MODULES, createFactoryGame } from '../components/world/factory/factory-game';
  import { createFactoryOperation, stepFactoryOperation } from '../components/world/factory/factory-operation';
  let lowered = false;
  const controls = document.createElement('nav');
  controls.setAttribute('aria-label', 'Press model review');
  controls.style.cssText = 'position:fixed;bottom:16px;right:16px;z-index:10000;display:flex;gap:6px;padding:8px;background:#20363e;color:white;border-radius:8px;flex-wrap:wrap;max-width:520px;font:13px sans-serif';
  let moduleIndex = 0, night = false, detail = false;
  const game = createFactoryGame('carrier-review-fixture');
  for (const module of FACTORY_MODULES) game.parts[module] = {id:`review-${module}`,module,materialId:`review-${module}`,manufacturedFor:'nimble'};
  const label = document.createElement('output');
  label.textContent = 'QA fixture · no save writes';
  controls.append(label);
  function show() {
    const z = [-11, 2, 15][moduleIndex], id = `press-review-${moduleIndex}-${detail?'detail':'work'}-${night?'night':'day'}`;
    if (!WORLD_SHOTS.some(shot => shot.id === id)) WORLD_SHOTS.push({id,position:factoryWorld(detail?[-32.5,4.8,z-6.3]:[-39,5.2,z+3.5]),target:factoryWorld(detail?[-27,3,z]:[-27.5,2.2,z])});
    const p = factoryWorld([-32,.95,z]);
    worldActorDebug.teleportPlayer(p);
    useFactoryStore.setState({game,active:true});
    const op=createFactoryOperation({type:'process',module:FACTORY_MODULES[moduleIndex]});
    op.stroke=lowered?1:0;op.guard=lowered?1:0;factoryControl.operation=op;
    selectWorldTime(night?'night':'noon');
    useWorldStore.setState({position:p,shot:id,paused:false,factoryStation:FACTORY_MODULES[moduleIndex],timeRunning:false});
    label.textContent = `QA fixture · ${FACTORY_MODULES[moduleIndex]} · ${night?'midnight':'noon'}`;
  }
  function button(text:string, action:()=>void) { const b=document.createElement('button'); b.textContent=text; b.style.cssText='padding:7px 12px;cursor:pointer'; b.onclick=action; controls.append(b); }
  FACTORY_MODULES.forEach((m,i)=>button(m,()=>{moduleIndex=i;show();}));
  button('Press up / down',()=>{lowered=!lowered;show();});
  button('Work / detail',()=>{detail=!detail;show();});
  button('Noon / midnight',()=>{night=!night;show();});
  button('Live work view',()=>{useWorldStore.setState({shot:null,paused:false});});
  button('One press cycle',()=>{
    const module=FACTORY_MODULES[moduleIndex],op=createFactoryOperation({type:'process',module});factoryControl.operation=op;
    useWorldStore.setState({shot:null,paused:false});let previous=performance.now();
    const step=(now:number)=>{
      const paused=useWorldStore.getState().paused||document.hidden;
      stepFactoryOperation(op,{x:0,z:0,held:true,confirm:false},(now-previous)/1000,paused);previous=now;
      if(op.phase==='outfeed'){label.textContent='QA cycle complete · no save writes';return;}
      requestAnimationFrame(step);
    };label.textContent='QA cycle running';requestAnimationFrame(step);
  });
  button('Play / pause',()=>{useWorldStore.setState({shot:null,paused:!useWorldStore.getState().paused});});
  document.body.append(controls);
</script>
